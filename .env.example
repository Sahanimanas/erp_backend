# Server Configuration
NODE_ENV=production
PORT=3000
APP_URL=https://api.your-domain.com

# Frontend URL (for CORS)
FRONTEND_URL=https://your-domain.com

# Database Configuration
# DATABASE_URL=postgresql://user:password@localhost:5432/school_erp_saas?schema=public
#  DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_erp_saas?schema=public"

#production (Neon) — replace user/password/host with your own; never commit real credentials
# DATABASE_URL="postgresql://<user>:<password>@<your-neon-host>/neondb?sslmode=require&channel_binding=require"
# JWT Secrets (Change these in production!)
# JWT Authentication (CHANGE THESE VALUES IN PRODUCTION!)
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=your-long-random-secret-key-here-change-this
JWT_REFRESH_SECRET=your-long-random-secret-key-here-change-this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@schoolerp.com

# SMS Configuration (Twilio)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# WhatsApp (Baileys — WhatsApp Web multi-device)
# Per-school credentials are stored under WHATSAPP_SESSION_DIR/<schoolId>.
# Use a persistent volume in production so the linked number survives restarts.
WHATSAPP_SESSION_DIR=./storage/whatsapp
WHATSAPP_DEVICE_NAME=School ERP
# Anti-ban throttling (one serial send queue per linked number). Bursts are
# spaced a RANDOM gap in [MIN,MAX] apart; lone sends after idle are immediate.
WHATSAPP_MIN_SEND_DELAY_MS=3000
WHATSAPP_MAX_SEND_DELAY_MS=10000
# Concurrent sends per account — WhatsApp tolerates 1–2; keep this low.
WHATSAPP_SEND_CONCURRENCY=1
# Exponential backoff for a failed send: base * 2^attempt (+ jitter), capped.
WHATSAPP_SEND_RETRIES=3
WHATSAPP_SEND_RETRY_BASE_MS=2000
# Exponential backoff for reconnecting a dropped socket (credentials preserved).
WHATSAPP_RECONNECT_BASE_MS=2000
WHATSAPP_RECONNECT_MAX_MS=60000

# File Storage (Cloudflare R2)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=school-erp-files
R2_PUBLIC_URL=https://files.schoolerp.com

# AWS S3 (Alternative to R2)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=school-erp-bucket

# Payment Processing (Stripe)
STRIPE_SECRET_KEY=sk_live_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here

# Image Hosting (Cloudinary) — used for student & employee profile photos
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=school-erp

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API Configuration
API_VERSION=v1
PLATFORM_DOMAIN=schoolerp.com

# Debugging (set to false in production)
DEBUG=false
