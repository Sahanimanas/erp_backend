generator client {
  provider = "prisma-client-js"
  // "native" for local/Docker; the rhel target is what Vercel's serverless
  // runtime (AWS Lambda, OpenSSL 3) needs. Keep both so the same client works
  // locally and on Vercel.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  TEACHER
  ACCOUNTANT
  STUDENT
  PARENT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  INACTIVE
  EXPIRED
  PENDING
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  LATE
  HALF_DAY
}

// Biometric / device attendance capture modes. A school may run any mix of
// these depending on the hardware it owns (RFID readers, fingerprint scanners,
// face terminals); each physical device declares which one it is.
enum BiometricModality {
  RFID
  FINGERPRINT
  FACE
}

enum PunchDirection {
  IN
  OUT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// How often a leave type's entitlement resets.
enum LeaveValidity {
  MONTHLY
  YEARLY
  SESSION
  ON_OCCASION
}

enum ExamType {
  UNIT_TEST
  HALF_YEARLY
  YEARLY
  MONTHLY
  CLASS_TEST
}

enum AdmissionStatus {
  ENQUIRY
  CONTACTED
  REGISTERED
  ADMITTED
  REJECTED
}

enum GradeType {
  A
  B
  C
  D
  E
  F
}

// ─────────────────────────────────────────────────────────────────────────
// PLATFORM LEVEL
// ─────────────────────────────────────────────────────────────────────────

model School {
  id                 String                 @id @default(cuid())
  name               String                 @unique
  slug               String                 @unique
  email              String                 @unique
  phone              String?
  address            String?
  city               String?
  state              String?
  pincode            String?
  country            String?
  logo               String?
  watermark          String?
  // UPI payment QR image (data URL / file URL). Printed on demand bills with
  // a "Pay on this QR" caption when set.
  upiQr              String?
  website            String?
  foundedYear        Int?
  principalName      String?
  principalEmail     String?
  schoolCode         String?                @unique
  registrationNumber String?                @unique
  isActive           Boolean                @default(true)
  // Per-tenant feature/module control (toggled by the Super Admin). Empty = all
  // modules enabled. Values mirror the keys in src/common/constants/modules.ts.
  enabledModules     String[]               @default([])
  // Linked WhatsApp number (Baileys). Persisted so the link survives server
  // restarts and page refreshes; cleared only on explicit disconnect.
  whatsappNumber     String?
  whatsappLinkedAt   DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?

  domains            SchoolDomain[]
  subscriptions      Subscription[]
  users              User[]
  students           Student[]
  employees          Employee[]
  classes            Class[]
  subjects           Subject[]
  fees               Fee[]
  attendance         StudentAttendance[]
  exams              Exam[]
  auditLogs          AuditLog[]
  academicYears      AcademicYear[]
  biometricDevices     BiometricDevice[]
  biometricEnrollments BiometricEnrollment[]
  attendancePunches    AttendancePunch[]

  @@index([slug])
  @@index([isActive])
  @@index([createdAt])
}

model SchoolDomain {
  id        String   @id @default(cuid())
  schoolId  String
  domain    String   @unique
  // "subdomain" (school.myerp.com) or "custom" (school.edu). Drives DNS/SSL flow.
  type      String   @default("subdomain")
  isPrimary Boolean  @default(false)
  isActive  Boolean  @default(true)
  // DNS / SSL provisioning state for custom domains: PENDING | VERIFYING | ACTIVE | FAILED
  dnsStatus String   @default("PENDING")
  sslStatus String   @default("PENDING")
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([domain])
}

model SubscriptionPlan {
  id                String         @id @default(cuid())
  name              String         @unique
  description       String?
  price             Float
  currency          String         @default("INR")
  billingCycle      String         @default("monthly")
  maxUsers          Int
  maxStudents       Int
  storageLimit      BigInt
  featureFlags      String[]       @default([])
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  subscriptions Subscription[]

  @@index([isActive])
}

model Subscription {
  id            String               @id @default(cuid())
  schoolId      String
  planId        String
  status        SubscriptionStatus   @default(ACTIVE)
  startDate     DateTime             @default(now())
  endDate       DateTime
  autoRenew     Boolean              @default(true)
  nextBillingDate DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?

  school School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@unique([schoolId])
  @@index([schoolId])
  @@index([status])
  @@index([endDate])
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String
  action    String
  entity    String
  entityId  String
  oldValues String?
  newValues String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// AUTHENTICATION
// ─────────────────────────────────────────────────────────────────────────

model User {
  id                 String     @id @default(cuid())
  schoolId           String
  firstName          String
  lastName           String
  // Optional: bulk-imported students often have no email. Never fabricate one —
  // a blank email is stored as NULL. Postgres treats NULLs as distinct, so many
  // emailless users coexist under the @@unique([email, schoolId]) index.
  email              String?
  phone              String?
  password           String
  role               UserRole
  isActive           Boolean    @default(true)
  emailVerified      Boolean    @default(false)
  phoneVerified      Boolean    @default(false)
  lastLogin          DateTime?
  lastPasswordChange DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student?
  employee       Employee?
  parent         Parent?
  refreshTokens  RefreshToken[]
  sessions       UserSession[]
  auditLogs      AuditLog[]
  rolePermissions RolePermission[]

  @@unique([email, schoolId])
  @@index([schoolId])
  @@index([email])
  @@index([role])
  @@index([isActive])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  deviceId  String
  ipAddress String?
  userAgent String?
  lastActivity DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
}

model Role {
  id          String   @id @default(cuid())
  name        UserRole @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]

  @@index([name])
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@index([name])
  @@index([category])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  userId       String?
  schoolId     String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([roleId, permissionId, schoolId])
  @@index([roleId])
  @@index([permissionId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// ACADEMIC
// ─────────────────────────────────────────────────────────────────────────

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  // Class Management → Add Session extras
  sessionCode      String?
  timetableSession String? // DEFAULT | ONLINE
  description      String?
  enabled          Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes Class[]
  feeStructures ClassFeeStructure[]
  exams   Exam[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([isActive])
}

model Class {
  id              String   @id @default(cuid())
  schoolId        String
  academicYearId  String
  name            String
  description     String?
  classTeacherId  String?
  // Class Management → Add Class extras
  classCode       String?
  classType       String?  // e.g. Yearly / Semester
  classSequence   Int?
  noOfSessions    Int      @default(1)
  departmentId    String?
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  sections     Section[]
  classSubjects ClassSubject[]
  examSchedules ExamSchedule[]
  classDetails  ClassDetail[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([academicYearId])
}

model Section {
  id        String   @id @default(cuid())
  classId   String
  schoolId  String
  name      String
  strength  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  class    Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  students Student[]
  timetableSlots TimetableSlot[]
  classTimetables ClassTimetable[]

  @@unique([classId, name])
  @@index([classId])
  @@index([schoolId])
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  code      String
  description String?
  // Class Management → Add Subject extras
  displayOrder Int     @default(0)
  totalMarks   Int     @default(100)
  passingMarks Int     @default(0)
  enabled      Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjects ClassSubject[]
  studentMarks  StudentMark[]
  examSubjects  ExamSubject[]
  examSchedules ExamSchedule[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model ClassSubject {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  teacherId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
}

// ─────────────────────────────────────────────────────────────────────────
// STUDENT
// ─────────────────────────────────────────────────────────────────────────

model Student {
  id             String   @id @default(cuid())
  schoolId       String
  userId         String   @unique
  rollNumber     String
  sectionId      String
  dateOfBirth    DateTime
  gender         String
  bloodGroup     String?
  category       String?
  caste          String?
  religion       String?
  motherTongue   String?
  aadharNumber   String?   @unique
  penNumber      String?
  apaarNo        String?
  smartCardNo    String?
  height         String?
  weight         String?
  remarks        String?
  photo          String?
  admissionDate  DateTime  @default(now())
  admissionNumber String?  @unique
  registrationNo String?
  feePlan        String?
  // Academic session the student belongs to, e.g. "2025-2026". Free-text so it
  // works whether or not the school manages sessions under Settings → Sessions.
  session        String?

  // Prior education history: array of { courseName, passingYear, marksOrGrade, schoolName }
  educationHistory Json?

  // Parent / guardian particulars (kept on the student record for quick search
  // & printing; a linked Parent login can still be created separately).
  fatherName     String?
  motherName     String?
  fatherAadhar   String?
  motherAadhar   String?
  fatherOccupation String?
  motherOccupation String?
  fatherQualification String?
  motherQualification String?
  guardianName   String?
  guardianPhone  String?
  guardianEmail  String?

  // Contact
  address          String?
  permanentAddress String?
  city             String?
  pincode          String?

  // Facilities
  hostelAllotted    Boolean @default(false)
  hostelName        String?
  hostelRoomNo      String?
  transportAllotted Boolean @default(false)
  transportRoute    String?
  busNo             String?
  // Months (e.g. ["Apr-2026","May-2026"]) the student uses transport. The route's
  // monthly fee is billed per selected month via the fee ledger (computed live,
  // like class fees — no stored fee rows).
  transportMonths   Json?

  // Enrollment status. A student who has LEFT the school is set inactive but
  // NOT deleted — their record + fee history stay in the DB for reference.
  // `leftDate` records when they left; `billedUntilMonth` (e.g. "Jun-2025") is
  // the last month for which recurring (Monthly/Quarterly) fees are billed —
  // months after it are not charged. Session / One-time fees are unaffected and
  // stay fully due (the admin can waive them via discount).
  isActive         Boolean   @default(true)
  leftDate         DateTime?
  billedUntilMonth String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  section     Section          @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  parents     Parent[]
  attendance  StudentAttendance[]
  fees        FeeCollection[]
  marks       StudentMark[]
  examSeats      ExamSeat[]
  examAttendance ExamAttendance[]
  documents   StudentDocument[]
  biometricEnrollments BiometricEnrollment[]
  attendancePunches    AttendancePunch[]
  transportRoutes      TransportStudentRoute[]

  @@unique([schoolId, rollNumber])
  @@index([schoolId])
  @@index([sectionId])
  @@index([userId])
}

model Parent {
  id            String   @id @default(cuid())
  schoolId      String
  userId        String   @unique
  relationship  String
  occupation    String?
  annualIncome  BigInt?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  students Student[]

  @@index([schoolId])
  @@index([userId])
}

model StudentDocument {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  type      String
  fileUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
}

// ─────────────────────────────────────────────────────────────────────────
// ADMISSION (enquiry → registered → admitted funnel)
// ─────────────────────────────────────────────────────────────────────────

model AdmissionEnquiry {
  id            String          @id @default(cuid())
  schoolId      String
  // Applicant
  studentName   String
  gender        String?
  dateOfBirth   DateTime?
  classApplying String?
  // Guardian / contact
  parentName    String?
  phone         String
  email         String?
  address       String?
  // Funnel
  status        AdmissionStatus @default(ENQUIRY)
  source        String?         // Walk-in | Online | Referral | Phone
  reference     String?
  registrationNo String?        @unique
  followUpDate  DateTime?
  notes         String?
  assignedToId  String?
  // Set when the enquiry is converted into a real Student (admission → student
  // bridge). Links the two panels so an admitted applicant becomes a student.
  admittedStudentId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  @@index([schoolId])
  @@index([status])
  @@index([createdAt])
  @@index([phone])
}

// ─────────────────────────────────────────────────────────────────────────
// EMPLOYEE
// ─────────────────────────────────────────────────────────────────────────

model Employee {
  id             String   @id @default(cuid())
  schoolId       String
  userId         String   @unique
  employeeCode   String
  departmentId   String?
  designationId  String?
  reportingToId  String?
  dateOfBirth    DateTime?
  gender         String?
  bloodGroup     String?
  city           String?
  address        String?
  permanentAddress String?
  fatherName     String?
  husbandName    String?
  qualification  String?
  rfidNumber     String?
  aadharNumber   String?  @unique
  panNumber      String?  @unique
  dateOfJoining  DateTime @default(now())
  bankAccount    String?
  ifscCode       String?
  baseSalary     BigInt?
  photo          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  school          School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      Department?         @relation(fields: [departmentId], references: [id])
  designation     Designation?        @relation(fields: [designationId], references: [id])
  attendance      EmployeeAttendance[]
  leaves          Leave[]
  leaveAssignments LeaveAssignment[]
  payslips        Payslip[]
  salaryPayments  SalaryPayment[]
  experiences     EmployeeExperience[]
  invigilations   ExamSchedule[]

  @@unique([schoolId, employeeCode])
  @@index([schoolId])
  @@index([userId])
  @@index([departmentId])
  @@index([designationId])
}

model EmployeeExperience {
  id              String   @id @default(cuid())
  schoolId        String
  employeeId      String
  employer        String
  role            String?
  totalExperience String?
  createdAt       DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([employeeId])
}

model Department {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  headId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  employees Employee[]
  salary    DepartmentSalary?

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Designation {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  level       Int      @default(1)
  description String?
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  employees Employee[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model LeaveType {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  shortName String
  /// Default leave count granted per validity period. 0 = uncapped.
  maxDays   Int
  paid      Boolean       @default(true)
  validity  LeaveValidity @default(YEARLY)
  enabled   Boolean       @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  leaves      Leave[]
  assignments LeaveAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

/// Per-employee entitlement for a leave type. Absent row ⇒ the type's
/// `maxDays` default applies; a row overrides it for that one employee.
model LeaveAssignment {
  id          String   @id @default(cuid())
  schoolId    String
  employeeId  String
  leaveTypeId String
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId])
  @@index([schoolId])
  @@index([leaveTypeId])
}

/// School holiday calendar — days excluded from the "actual" leave day count.
model Holiday {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([schoolId, date])
  @@index([schoolId])
}

model Leave {
  id           String      @id @default(cuid())
  schoolId     String
  employeeId   String
  leaveTypeId  String
  startDate    DateTime
  endDate      DateTime
  days         Int
  /// Days actually deducted — `days` minus Sundays and calendar holidays.
  actualDays   Int?
  reason       String
  status       LeaveStatus @default(PENDING)
  approvedBy   String?
  /// When the leave was approved / rejected / cancelled.
  actionDate   DateTime?
  remarks      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType  LeaveType  @relation(fields: [leaveTypeId], references: [id])

  @@index([schoolId])
  @@index([employeeId])
  @@index([status])
}

model EmployeeAttendance {
  id        String   @id @default(cuid())
  schoolId  String
  employeeId String
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  inTime    String?
  outTime   String?
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([schoolId, employeeId, date])
  @@index([schoolId])
  @@index([employeeId])
  @@index([date])
}

model Payslip {
  id        String   @id @default(cuid())
  schoolId  String
  employeeId String
  month     Int
  year      Int
  basicSalary BigInt
  allowances  BigInt
  deductions  BigInt
  tax        BigInt
  netSalary  BigInt
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([schoolId, employeeId, month, year])
  @@index([schoolId])
  @@index([employeeId])
}

// ─────────────────────────────────────────────────────────────────────────
// EMPLOYEE SALARY MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────

/// Department-wide monthly salary template. One row per department; it is the
/// fallback rate for every employee in that department who has no individual
/// `Employee.baseSalary` of their own.
model DepartmentSalary {
  id           String   @id @default(cuid())
  schoolId     String
  departmentId String   @unique
  /// Monthly basic pay, in whole rupees.
  basicSalary  BigInt
  /// Monthly allowances added on top of basic (HRA, DA, …).
  allowances   BigInt   @default(0)
  /// Monthly deductions taken off (PF, TDS, …).
  deductions   BigInt   @default(0)
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

/// One salary disbursement covering one or more months of a single year.
/// `months` holds the selected month numbers (1–12); the payable total is
/// `months.length × (monthlySalary + allowances − deductions)`, frozen at the
/// moment of payment so later structure edits never rewrite history.
model SalaryPayment {
  id            String    @id @default(cuid())
  schoolId      String
  employeeId    String
  year          Int
  /// Month numbers 1–12 this payment covers.
  months        Int[]
  monthCount    Int
  /// Per-month rate applied, captured at payment time.
  monthlySalary BigInt
  allowances    BigInt    @default(0)
  deductions    BigInt    @default(0)
  /// monthCount × (monthlySalary + allowances − deductions)
  totalAmount   BigInt
  /// CASH | BANK_TRANSFER | CHEQUE | UPI | ONLINE
  paymentMode   String
  /// PAID (disbursed) | PENDING (saved, not yet disbursed)
  status        String    @default("PAID")
  paidDate      DateTime?
  remarks       String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([employeeId])
  @@index([schoolId, year])
}

// ─────────────────────────────────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────────────────────────────────

model StudentAttendance {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId, date])
  @@index([schoolId])
  @@index([studentId])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────────────────
// BIOMETRIC / DEVICE ATTENDANCE
// A physical attendance terminal (RFID / fingerprint / face). The device posts
// punch events to the public ingest endpoint, authenticating with `apiKey`.
// ─────────────────────────────────────────────────────────────────────────
model BiometricDevice {
  id           String            @id @default(cuid())
  schoolId     String
  name         String
  modality     BiometricModality
  // Serial / device id the hardware reports in its payload (used as a fallback
  // match when the API key is shared or proxied).
  serialNumber String?
  // Secret the device sends (header `x-device-key`) to authenticate ingestion.
  apiKey       String            @unique
  ipAddress    String?
  location     String?
  // A first IN punch at/after this minute-of-day is marked LATE (default 09:00).
  lateAfterMinutes Int           @default(540)
  isActive     Boolean           @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  school      School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments BiometricEnrollment[]
  punches     AttendancePunch[]

  @@index([schoolId])
  @@index([serialNumber])
}

// Maps a device-side identity (the user id enrolled on the terminal, and/or an
// RFID card number) to an ERP student, so an incoming punch can be resolved.
model BiometricEnrollment {
  id           String            @id @default(cuid())
  schoolId     String
  studentId    String
  modality     BiometricModality
  // The user/person id configured on the terminal (Hikvision employeeNoString).
  deviceUserId String?
  // RFID card number, when the modality is card-based.
  cardNumber   String?
  // Optional: restrict this mapping to one device (else any device matches).
  deviceId     String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  school  School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  device  BiometricDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([schoolId, deviceUserId])
  @@unique([schoolId, cardNumber])
  @@index([schoolId])
  @@index([studentId])
  @@index([cardNumber])
}

// Raw punch log — one row per scan received from a device. `studentId` is set
// when the punch resolves to an enrollment; unmatched punches are still stored
// (matched = false) so admins can fix enrollment and reprocess.
model AttendancePunch {
  id         String            @id @default(cuid())
  schoolId   String
  deviceId   String?
  studentId  String?
  // Identifier the device reported (employeeNo / personId) before resolution.
  rawUserId  String?
  cardNumber String?
  modality   BiometricModality
  direction  PunchDirection    @default(IN)
  eventTime  DateTime
  matched    Boolean           @default(false)
  raw        Json?
  createdAt  DateTime          @default(now())

  school  School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  device  BiometricDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  student Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([deviceId])
  @@index([studentId])
  @@index([eventTime])
}

// ─────────────────────────────────────────────────────────────────────────
// FEES
// ─────────────────────────────────────────────────────────────────────────

model FeeGroup {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  feeTypes FeeType[]
  fees     Fee[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model FeeType {
  id        String   @id @default(cuid())
  schoolId  String
  groupId   String
  name      String
  amount    BigInt
  isOptional Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  group FeeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([groupId])
}

model Fee {
  id        String   @id @default(cuid())
  schoolId  String
  sectionId String
  groupId   String
  dueDate   DateTime
  fine      BigInt   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  group       FeeGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  collections FeeCollection[]

  @@index([schoolId])
  @@index([sectionId])
  @@index([groupId])
  @@index([dueDate])
}

model FeeCollection {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  feeId     String
  amount    BigInt
  paidDate  DateTime
  status    PaymentStatus @default(PENDING)
  receiptNo String?  @unique
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fee     Fee     @relation(fields: [feeId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
  @@index([feeId])
  @@index([status])
  @@index([paidDate])
}

// ─────────────────────────────────────────────────────────────────────────
// FEE MANAGEMENT (class fee types → per-class structure; transport routes)
// ─────────────────────────────────────────────────────────────────────────

model ClassFeeType {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  // Session | Monthly | One-time — how often the fee recurs.
  frequency   String   @default("Monthly")
  // Applicable months for Monthly frequency (e.g. ["Jun-2025", ...]).
  months      String[] @default([])
  incomeHead  String?
  isTransport Boolean  @default(false)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  structures ClassFeeStructure[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([isTransport])
}

model ClassFeeStructure {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String
  feeTypeId String
  // Academic session (year) this amount applies to. Null = legacy/all-session
  // fallback. Lets the same class carry different fees per session.
  academicYearId String?
  amount    BigInt   @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feeType      ClassFeeType  @relation(fields: [feeTypeId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([classId, feeTypeId, academicYearId])
  @@index([schoolId])
  @@index([classId])
  @@index([academicYearId])
}

// A transport route. Shared by BOTH Fee Management (which sets `fee`) and the
// Transport module (which sets the operational columns below) — one row per
// route, so a route created on either screen shows up on the other.
model TransportRoute {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  fee       BigInt   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // ── Operational detail (Transport module). All optional so routes created
  // from the Fee Management screen — which only knows name + fee — stay valid.
  routeFrom String?
  routeTo   String?
  vehicleId String?
  driverId  String?
  staffId   String?            // Employee assigned to accompany the route
  enabled   Boolean  @default(true)

  vehicle   TransportVehicle? @relation(fields: [vehicleId], references: [id])
  driver    TransportDriver?  @relation(fields: [driverId], references: [id])
  stoppages TransportRouteStoppage[]
  students  TransportStudentRoute[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([vehicleId])
  @@index([driverId])
}

// Live GPS position of a route's bus. Fed by the vehicle's GPS device (or a
// driver share) and read by the student/admin tracking map. One row per route.
model TransportRouteLocation {
  id         String   @id @default(cuid())
  schoolId   String
  routeId    String   @unique
  latitude   Float
  longitude  Float
  speed      Float?   // km/h
  heading    Float?   // degrees 0-360
  moving     Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([schoolId])
}

// A bus/van in the school fleet.
model TransportVehicle {
  id            String   @id @default(cuid())
  schoolId      String
  name          String
  vehicleNumber String
  vehicleModel  String?
  gpsDeviceId   String?
  seatCapacity  Int      @default(0)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  routes        TransportRoute[]

  @@unique([schoolId, vehicleNumber])
  @@index([schoolId])
}

model TransportDriver {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  licenseNo String
  phone     String?
  email     String?
  age       Int?
  address   String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  routes    TransportRoute[]

  @@index([schoolId])
}

// A pickup/drop point. Latitude/longitude are optional — a stop can be recorded
// by name alone and pinned on the map later.
model TransportStoppage {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  latitude  Float?
  longitude Float?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  routeLinks TransportRouteStoppage[]
  students   TransportStudentRoute[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

enum TransportStopType {
  START_POINT
  STOPPAGE_POINT
  END_POINT
}

// A stop's place in a route: which stop, at what time, in what order.
model TransportRouteStoppage {
  id         String   @id @default(cuid())
  schoolId   String
  routeId    String
  stoppageId String
  time       String?              // "07:30" — clock time, not a timestamp
  sequenceNo Int      @default(0)
  stopType   TransportStopType @default(STOPPAGE_POINT)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  route      TransportRoute    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stoppage   TransportStoppage @relation(fields: [stoppageId], references: [id], onDelete: Cascade)

  @@unique([routeId, stoppageId])
  @@index([schoolId])
  @@index([routeId])
  @@index([stoppageId])
}

// Which student boards which route at which stop. This is the FK-based link
// that replaces matching Student.transportRoute by name string.
model TransportStudentRoute {
  id             String   @id @default(cuid())
  schoolId       String
  routeId        String
  stoppageId     String
  studentId      String
  academicYearId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  route          TransportRoute    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stoppage       TransportStoppage @relation(fields: [stoppageId], references: [id], onDelete: Cascade)
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([schoolId])
  @@index([routeId])
  @@index([stoppageId])
  @@index([studentId])
}

// A single fee payment line against a ClassFeeType for a student. The "ledger"
// (expected vs paid vs due) is computed by joining ClassFeeStructure (expected
// amount for the student's class) against the sum of FeePayment rows.
model FeePayment {
  id         String   @id @default(cuid())
  schoolId   String
  studentId  String
  feeTypeId  String?
  feeTypeName String?            // denormalised label (survives fee-type rename/delete)
  month      String?            // "Jun-2025" for monthly fees, null otherwise
  amount     BigInt   @default(0)
  discount   BigInt   @default(0)
  fine       BigInt   @default(0)
  paidDate   DateTime @default(now())
  receiptNo  String?
  mode       String   @default("CASH") // CASH | ONLINE | CHEQUE | BANK
  // PAID | DISCOUNT (a pure discount line) | EXTRA (an extra charge line)
  kind       String   @default("PAID")
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
  @@index([feeTypeId])
  @@index([receiptNo])
  @@index([paidDate])
}

model LateFeeRule {
  id                  String   @id @default(cuid())
  schoolId            String
  name                String
  session             String?
  applicableFeeType   String?  // fee type the rule applies to (name)
  lateFeeType         String?  // label of the late-fine fee
  lateFeeAmount       BigInt   @default(0)
  chargeAfterDueDays  Int      @default(0)
  startFromCurrentMonth Boolean @default(true)
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  @@index([schoolId])
}

// ─────────────────────────────────────────────────────────────────────────
// EXAMS
// ─────────────────────────────────────────────────────────────────────────

model Exam {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String?            // session the exam belongs to (null = legacy rows)
  name           String
  type           ExamType
  status         String   @default("draft") // draft | published | closed
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear?  @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  subjects  ExamSubject[]
  marks     StudentMark[]
  schedules ExamSchedule[]
  seats     ExamSeat[]

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([type])
}

// One row per paper: exam × class × subject × paperName. A subject may have
// several papers in the same exam (e.g. Sanskrit "Theory" and Sanskrit "Oral"),
// which is why paperName is part of the unique key.
model ExamSchedule {
  id            String   @id @default(cuid())
  schoolId      String
  examId        String
  classId       String
  subjectId     String
  paperName     String   @default("Theory") // Theory | Oral | Practical | Main …
  examDate      DateTime
  startTime     String   @default("09:00")
  endTime       String   @default("12:00")
  room          String?
  examCode      String?
  invigilatorId String?
  subSubject    Boolean  @default(false)
  maxMarks      Int      @default(100)
  minMarks      Int      @default(33) // pass / cut-off marks
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exam        Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  class       Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  invigilator Employee?        @relation(fields: [invigilatorId], references: [id], onDelete: SetNull)
  attendance  ExamAttendance[]

  @@unique([examId, classId, subjectId, paperName])
  @@index([schoolId])
  @@index([examId])
  @@index([classId])
  @@index([invigilatorId])
}

model ExamHall {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  roomNo    String?
  capacity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  seats ExamSeat[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// Seat allocation for an exam (sitting plan / hall ticket / hall plan).
model ExamSeat {
  id        String   @id @default(cuid())
  schoolId  String
  examId    String
  hallId    String
  studentId String
  seatNo    String
  createdAt DateTime @default(now())

  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  hall    ExamHall @relation(fields: [hallId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([schoolId])
  @@index([examId, hallId])
}

// School-wide grade bands (Setup Exam Grading); used to grade exam results.
model GradingScale {
  id         String   @id @default(cuid())
  schoolId   String
  grade      String
  minPercent Int
  maxPercent Int
  gradePoint Float?
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([schoolId, grade])
  @@index([schoolId])
}

// Per-paper attendance (exam schedule row × student).
model ExamAttendance {
  id         String   @id @default(cuid())
  schoolId   String
  scheduleId String
  studentId  String
  status     String   @default("PRESENT") // PRESENT | ABSENT
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  schedule ExamSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student  Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, studentId])
  @@index([schoolId])
  @@index([scheduleId])
}

model ExamSubject {
  id        String   @id @default(cuid())
  examId    String
  subjectId String
  totalMarks Int
  passingMarks Int
  createdAt DateTime @default(now())

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examId, subjectId])
  @@index([examId])
  @@index([subjectId])
}

model StudentMark {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  examId    String
  subjectId String
  marks     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId, examId, subjectId])
  @@index([schoolId])
  @@index([studentId])
  @@index([examId])
}

// ─────────────────────────────────────────────────────────────────────────
// TIMETABLE
// ─────────────────────────────────────────────────────────────────────────

model Period {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timetableSlots TimetableSlot[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model TimetableSlot {
  id        String   @id @default(cuid())
  schoolId  String
  sectionId String
  periodId  String
  subjectId String
  day       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  period  Period  @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([schoolId, sectionId, periodId, day])
  @@index([schoolId])
  @@index([sectionId])
}

// Rich, video-style class timetable. ONE row per (section, timetableSession,
// academicYear). `session` is the timetable-session toggle DEFAULT | ONLINE
// (NOT the academic year). Cells carry their own start/end time, subject,
// teacher (allotment) and optional online-class link — so the Add, View,
// Teacher-Allotment, Employee and Session-Day pages all read this one source.
model ClassTimetable {
  id             String   @id @default(cuid())
  schoolId       String
  sectionId      String
  session        String   @default("DEFAULT") // DEFAULT | ONLINE (timetable session)
  academicYearId String?
  maxPeriods     Int      @default(8)
  completed      Boolean  @default(false)
  classTeacherId String?  // Employee id
  periodLabels   String[] @default([]) // editable column headers ("Period 1", "URDU", …)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  section Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  cells   ClassTimetableCell[]

  @@unique([schoolId, sectionId, session, academicYearId])
  @@index([schoolId])
  @@index([sectionId])
}

model ClassTimetableCell {
  id          String   @id @default(cuid())
  schoolId    String
  timetableId String
  day         String   // Monday … Saturday
  periodIndex Int      // 0-based column position
  startTime   String?
  endTime     String?
  subjectId   String?
  teacherId   String?  // Employee id (allotment)
  onlineLink  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  timetable ClassTimetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  @@unique([timetableId, day, periodIndex])
  @@index([timetableId])
  @@index([schoolId, day])
  @@index([schoolId, teacherId])
}

// ─────────────────────────────────────────────────────────────────────────
// CLASS MANAGEMENT (Add Class Details / Non-Subject / Syllabus / Emp mapping)
// ─────────────────────────────────────────────────────────────────────────

// Per-year detail of a class (a class may run over N "years"/semesters).
model ClassDetail {
  id                    String   @id @default(cuid())
  schoolId              String
  classId               String
  yearIndex             Int      // 1-based "Year N"
  name                  String?
  classCode             String?
  maxInternalExam       Int?
  bestInternalExamCount Int?
  noOfElectiveSubject   Int?
  enabled               Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, yearIndex])
  @@index([schoolId])
  @@index([classId])
}

// Co-curricular / non-academic subjects (Music, Dance, …) scored separately.
model NonSubject {
  id           String   @id @default(cuid())
  schoolId     String
  classId      String?
  name         String
  totalMarks   Int      @default(100)
  displayOrder Int      @default(0)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([schoolId])
  @@index([classId])
}

// Rich-text class syllabus with optional file attachments.
model Syllabus {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String?
  classId        String
  sectionId      String?
  title          String
  content        String   @default("") // rich HTML
  attachments    Json?    // [{ name, url }]
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([schoolId])
  @@index([classId])
}

// Which subjects / non-subjects an employee (teacher) is assigned for a class.
model EmployeeSubjectMap {
  id             String   @id @default(cuid())
  schoolId       String
  employeeId     String
  classId        String
  academicYearId String?
  subjectId      String?
  nonSubjectId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([schoolId])
  @@index([employeeId])
  @@index([classId])
}

// ─────────────────────────────────────────────────────────────────────────
// RESULT MANAGEMENT (builds on Exam Management: StudentMark/Exam/GradingScale)
// ─────────────────────────────────────────────────────────────────────────

// Co-curricular (non-subject) result, graded per Term rather than per exam.
model NonSubjectMark {
  id           String   @id @default(cuid())
  schoolId     String
  studentId    String
  nonSubjectId String
  term         String
  marks        Int?
  grade        String?
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, nonSubjectId, term])
  @@index([schoolId])
  @@index([studentId])
}

// Free-text remark shown on a student's report card (per session/term).
model ReportCardRemark {
  id             String   @id @default(cuid())
  schoolId       String
  studentId      String
  academicYearId String?
  term           String   @default("")
  remark         String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, academicYearId, term])
  @@index([schoolId])
}

// A generated report card snapshot (aggregated marks + remarks) for a student,
// stored as JSON so View/Publish/Print render exactly what was generated.
model GeneratedReportCard {
  id             String   @id @default(cuid())
  schoolId       String
  studentId      String
  sectionId      String?
  academicYearId String?
  term           String   @default("")
  data           Json
  published      Boolean  @default(false)
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, academicYearId, term])
  @@index([schoolId])
  @@index([sectionId])
}

// Publish state of an exam's results for a given section (controls parent/student
// visibility). One row per (exam, section).
model ExamResultPublish {
  id          String   @id @default(cuid())
  schoolId    String
  examId      String
  sectionId   String
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())

  @@unique([examId, sectionId])
  @@index([schoolId])
}

// ─────────────────────────────────────────────────────────────────────────
// WHATSAPP TEMPLATES
// ─────────────────────────────────────────────────────────────────────────

// Reusable message templates with {{placeholders}}. `event` decides when a
// template fires automatically: MANUAL (never), STUDENT_CREATED (on new
// student), PAYMENT_RECEIVED (on fee collection / manual receipt send).
model WhatsAppTemplate {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  body      String
  event     String   @default("MANUAL") // MANUAL | STUDENT_CREATED | PAYMENT_RECEIVED
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, event])
}

model WhatsAppAuthFile {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

// Per-school, per-day WhatsApp message counters. Incremented from the send
// queue (sent / failed) and from delivery receipts (delivered / read) so the
// "Message Counts" page shows durable totals that survive server restarts.
model WhatsAppMessageStat {
  id        String   @id @default(cuid())
  schoolId  String
  date      DateTime @db.Date
  sent      Int      @default(0)
  failed    Int      @default(0)
  delivered Int      @default(0)
  read      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, date])
  @@index([schoolId])
}

// ─────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String?
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([userId])
  @@index([isRead])
}

model Message {
  id        String   @id @default(cuid())
  schoolId  String
  senderId  String
  recipientId String
  subject   String?
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([senderId])
  @@index([recipientId])
}

// Two-way notice board: admin ⇄ teacher ⇄ student. `audience` decides who
// receives it; `senderRole` shows who sent it. `readBy` holds userIds who read it.
model Notice {
  id         String   @id @default(cuid())
  schoolId   String
  senderId   String
  senderName String
  senderRole String   // SCHOOL_ADMIN | PRINCIPAL | TEACHER | STUDENT
  audience   String   // STUDENTS | TEACHERS | ADMINS | ALL
  title      String
  message    String
  readBy     String[] @default([])
  createdAt  DateTime @default(now())

  @@index([schoolId])
  @@index([audience])
  @@index([senderId])
}

model Announcement {
  id        String   @id @default(cuid())
  schoolId  String
  authorId  String
  title     String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([schoolId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// FILES
// ─────────────────────────────────────────────────────────────────────────

model File {
  id        String   @id @default(cuid())
  schoolId  String
  uploadedBy String
  fileName  String
  fileUrl   String   @unique
  fileType  String
  fileSize  BigInt
  mimeType  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([schoolId])
  @@index([uploadedBy])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// OFFICE ACCOUNTING
// ─────────────────────────────────────────────────────────────────────────

enum AccountType {
  CASH
  BANK
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Account {
  id             String      @id @default(cuid())
  schoolId       String
  name           String
  type           AccountType @default(CASH)
  accountNumber  String?
  bankName       String?
  openingBalance BigInt      @default(0)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  transactions Transaction[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model VoucherHead {
  id          String          @id @default(cuid())
  schoolId    String
  name        String
  type        TransactionType
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  transactions Transaction[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([type])
}

model Transaction {
  id            String          @id @default(cuid())
  schoolId      String
  accountId     String
  voucherHeadId String?
  type          TransactionType
  amount        BigInt
  date          DateTime        @default(now())
  description   String?
  reference     String?
  createdBy     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  voucherHead VoucherHead? @relation(fields: [voucherHeadId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([accountId])
  @@index([voucherHeadId])
  @@index([type])
  @@index([date])
}

// ── Class content: one table for Homework / Diary / Syllabus / Holiday / Events
// / Online Class / Study Documents. sectionId null = whole-school (holidays, events).
enum ContentType {
  HOMEWORK
  DIARY
  SYLLABUS
  HOLIDAY
  EVENT
  ONLINE_CLASS
  STUDY_DOC
}

model ClassContent {
  id            String      @id @default(cuid())
  schoolId      String
  type          ContentType
  title         String
  description   String?
  subjectName   String?     // denormalised subject label (optional)
  sectionId     String?     // null = whole school
  date          DateTime?   // event/holiday/online-class date
  dueDate       DateTime?   // homework due date
  link          String?     // online class link / doc / syllabus url
  createdBy     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  @@index([schoolId, type])
  @@index([sectionId])
}
