{
  "name": "school-erp-backend",
  "version": "1.0.0",
  "description": "Enterprise School ERP SaaS Backend - Production Grade",
  "main": "dist/server.js",
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register src/server.ts",
    "build": "tsc && tsc-alias",
    "vercel-build": "prisma generate && tsc && tsc-alias",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:seed": "npx tsx prisma/seed.ts",
    "test": "vitest",
    "test:cov": "vitest --coverage"
  },
  "dependencies": {
    "@prisma/client": "5.7.0",
    "aws-sdk": "2.1500.0",
    "axios": "1.6.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "2.4.3",
    "bullmq": "4.14.0",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "4.18.2",
    "express-rate-limit": "7.0.0",
    "helmet": "7.0.0",
    "joi": "17.10.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "pg": "8.11.0",
    "redis": "4.6.10",
    "typescript": "5.3.3",
    "uuid": "9.0.0",
    "winston": "3.11.0",
    "zod": "3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@vitest/ui": "^1.1.1",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "prisma": "^5.8.0",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "vitest": "^1.1.1"
  }
}
